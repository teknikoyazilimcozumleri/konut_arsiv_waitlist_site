---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactForm from "../components/ContactForm.astro";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`Contact | ${SITE.title}`}
  description="Get in touch with us. We'd love to hear from you about Astro Base or any questions you may have."
  canonicalURL={`${SITE.url}/contact`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-2xl mx-auto pt-20">
      <h1 class="text-5xl font-bold text-gray-900">Contact</h1>
      <p class="text-xl text-gray-600 pt-4">Get in touch with us. We'd love to hear from you.</p>      
      <ContactForm />
    </section>
  </main>
  <Footer />
</Layout>

