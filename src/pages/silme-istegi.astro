---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`Silme İsteği | ${SITE.title}`}
  description="Verilerinizi silmek için bizimle iletişime geçin."
  canonicalURL={`${SITE.url}/silme-istegi`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-2xl mx-auto py-20">
      <h1 class="text-5xl font-bold text-gray-900">Silme İsteği</h1>
      <p class="text-xl text-gray-600 pt-4">
        Eğer bizde bir hesabınız varsa ve verilerinizi silmek istiyorsanız, lütfen 
        <a
          href="mailto:info@teknikoyazilimcozumleri.com"
          class="text-[#0f2f76] font-semibold hover:text-[#ff3131] transition-colors"
        >
          {" "}info@teknikoyazilimcozumleri.com
        </a>
        adresine bir silme talebi gönderin.
      </p>
    </section>
  </main>
  <Footer />
</Layout>

