---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FeaturesComponent from "../components/Features.astro";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`Features | ${SITE.title}`}
  description="Discover all the features included in Astro Base: React, Tailwind CSS, Astro Icons, Sass"
  canonicalURL={`${SITE.url}/features`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="max-w-6xl mx-auto px-4 py-20">
      <h1 class="text-5xl font-bold text-gray-900 mb-4">Features</h1>
      <p class="text-xl text-gray-600 mb-12">
        The features that you need to get going quickly
      </p>
      <FeaturesComponent />
    </section>
  </main>
  <Footer />
</Layout>
