---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../config/site.mjs";
---

<Layout
  title={`Hakkımızda | ${SITE.title}`}
  description="KonutArşiv; 7/24 destek, güçlü veri güvenliği ve sektör standartlarına uygun geliştirme yaklaşımıyla kurumlara güvenilir dijital çözümler sunar."
  canonicalURL={`${SITE.url}/hakkimizda`}
>
  <Header />
  <main id="main-content" role="main">
    <section class="bg-gradient-to-b from-white to-slate-50 border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-4 py-20">
        <span class="inline-flex items-center rounded-full bg-[#0f2f76]/10 text-[#0f2f76] px-4 py-1 text-sm font-semibold mb-6">
          Güvenilir B2B Yazılım Partneriniz
        </span>
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-slate-900 mb-6">
          {SITE.title} Hakkında
        </h1>
        <p class="text-lg md:text-xl leading-relaxed text-slate-600 max-w-4xl">
          KonutArşiv, Tekniko Yazılım Çözümleri tarafından geliştirilen bir platformdur. Ankara merkezli ekibimizle, kurumların operasyonlarını daha verimli hale getiren güvenilir B2B yazılımlar üretir; her aşamada sürdürülebilirlik, şeffaf iletişim ve ölçülebilir sonuçları odağa alırız.
        </p>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 py-16">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
          <h2 class="text-xl font-semibold text-slate-900 mb-3">7/24 Operasyonel Destek</h2>
          <p class="text-slate-600 leading-relaxed">
            Kritik süreçlerinizin kesintisiz devam etmesi için 7/24 destek sağlıyor, ihtiyaç duyduğunuz her anda hızlı geri dönüş ve çözüm odaklı teknik yardım sunuyoruz.
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
          <h2 class="text-xl font-semibold text-slate-900 mb-3">Veri Güvenliği Önceliği</h2>
          <p class="text-slate-600 leading-relaxed">
            Müşteri verilerini en değerli varlık olarak görürüz. Erişim kontrolleri, düzenli güvenlik güncellemeleri ve güvenli geliştirme prensipleriyle verilerinizi koruruz.
          </p>
        </article>
        <article class="rounded-2xl border border-slate-200 bg-white p-7 shadow-sm">
          <h2 class="text-xl font-semibold text-slate-900 mb-3">Best Practice Yaklaşımı</h2>
          <p class="text-slate-600 leading-relaxed">
            Mimari tasarımdan canlıya alma süreçlerine kadar sektörde kabul görmüş en iyi uygulamaları takip eder; bakım kolaylığı yüksek, ölçeklenebilir çözümler geliştiririz.
          </p>
        </article>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 pb-20">
      <div class="rounded-2xl bg-[#0f2f76] p-8 md:p-10 text-white flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-3xl">
          <h2 class="text-2xl md:text-3xl font-semibold mb-3">Uzun vadeli iş ortaklığı için buradayız</h2>
          <p class="text-slate-200 leading-relaxed">
            Hedefimiz sadece bir ürün sunmak değil, ekiplerinizin günlük iş akışına gerçek değer katan güvenilir bir dijital altyapı oluşturmaktır.
          </p>
        </div>
        <a
          href="https://www.teknikoyazilimcozumleri.com"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center px-6 py-3 rounded-lg bg-[#ff3131] text-white font-medium hover:bg-[#e12a2a] transition-colors whitespace-nowrap"
        >
          Bizi Ziyaret Edin
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
