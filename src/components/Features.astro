---
import { Icon } from "astro-icon/components";
import { OZELLIKLER } from "../config/ozellikler.mjs";
---

<section id="features" class="max-w-6xl mx-auto px-4 py-20">
  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
    {
      OZELLIKLER.map((ozellik) => (
        <article class="p-6 bg-white rounded-lg border border-gray-200 hover:shadow-lg transition-shadow">
          <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center mb-4">
            <Icon name={`tabler:${ozellik.icon}`} class="w-6 h-6 text-gray-900" aria-hidden="true" />
          </div>
          <h3 class="text-xl font-semibold text-gray-900 mb-2">{ozellik.title}</h3>
          <p class="text-gray-600">{ozellik.description}</p>
        </article>
      ))
    }
  </div>
</section>
