---
import ScrollReveal from "./ScrollReveal.tsx";
import { Icon } from "astro-icon/components";
---

<section id="about" class="max-w-6xl mx-auto px-4 py-20">
    <div class="bg-[#0f2f76] rounded-2xl p-12 text-center text-white">
      <h2 class="text-4xl font-bold mb-4">Gayrimenkul yönetiminizi basitleştirmeye hazır mısınız?</h2>
      <p class="text-xl text-gray-300 mb-8 max-w-2xl mx-auto">
        Start building your next project with this minimal and powerful starter
        template.
      </p>
      <a
        href="https://github.com/teknikoyazilimcozumleri/astro-website-template"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-3 bg-[#ff3131] text-white rounded-lg hover:bg-[#0f2f76] transition-colors font-medium"
      >
        <Icon name="tabler:download" class="w-5 h-5" aria-hidden="true" />
        İndir
      </a>
    </div>
</section>
