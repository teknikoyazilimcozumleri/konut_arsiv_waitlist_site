---
import { Icon } from "astro-icon/components";
import { SITE } from "../config/site.mjs";
---

<section class="max-w-6xl mx-auto px-4 py-20 md:py-32 text-center" aria-labelledby="hero-heading">
    <h1 id="hero-heading" class="text-5xl md:text-6xl font-bold text-[#0f2f76] mb-6">
      Tek bir uygulama. Tüm mülkleriniz.
    </h1>
    <p class="text-xl md:text-2xl text-gray-600 mb-8 max-w-2xl mx-auto">
      Kiracılarınızı yönetmek için ihtiyacınız olan her şey tek bir uygulamada.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href={SITE.downloadUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-2.5 text-base bg-[#ff3131] text-white rounded-lg hover:bg-[#0f2f76] transition-colors font-medium leading-none"
        aria-label="KonutArşiv'i İndir"
        data-download-link
        data-ios-url={SITE.iosDownloadUrl}
        data-android-url={SITE.androidDownloadUrl}
        data-fallback-url={SITE.downloadUrl}
      >
        <Icon name="tabler:download" class="w-4 h-4" aria-hidden="true" />
        <span>İndir</span>
      </a>
      <a
        href="/ozellikler"
        class="inline-block px-8 py-3 bg-white text-gray-900 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors font-medium"
      >
        Daha Fazla Öğren
      </a>
    </div>
</section>
